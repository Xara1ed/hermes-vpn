{
    "log": {
        "loglevel": "none"
    },
    "inbounds": [
        {
            "tag": "proxy",
            "listen": "0.0.0.0",
            "port": 8080,
            "protocol": "vless",
            "settings": {
                "clients": [
                    {
                        "id": "9d509ca5-e544-46e4-be57-613b240299d1",
                        "flow": "xtls-rprx-vision"
                    }
                ],
                "decryption": "none"
            },
            "streamSettings": {
                "network": "xhttp",
                "xhttpSettings": {
                    "path": "/api/v1",
                    "mode": "packet-up"
                },
                "security": "tls",
                "tlsSettings": {
                    "serverName": "hermes-vpn-production.up.railway.app",
                    "alpn": ["h2", "http/1.1"],
                    "fingerprint": "chrome"
                }
            },
            "sniffing": {
                "enabled": true,
                "destOverride": ["http", "tls"]
            }
        }
    ],
    "outbounds": [
        {
            "protocol": "freedom",
            "tag": "direct"
        }
    ]
}
